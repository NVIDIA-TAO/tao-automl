    {
      "type": "text", "id": "hidden_title", "x": 610, "y": 545, "width": 440, "height": 22,
      "text": "What the runner hides (agent never sees):",
      "originalText": "What the runner hides (agent never sees):",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
