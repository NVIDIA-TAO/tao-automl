    {
      "type": "text", "id": "sdk_owns_text", "x": 850, "y": 400, "width": 190, "height": 120,
      "text": "SDK owns:\n\n  Platform selection\n  Backend handlers\n  Resource allocation\n  Credentials\n  Job submission\n  Dataset injection",
      "originalText": "SDK owns:\n\n  Platform selection\n  Backend handlers\n  Resource allocation\n  Credentials\n  Job submission\n  Dataset injection",
