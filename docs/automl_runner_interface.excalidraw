    {
      "type": "text", "id": "returns_text", "x": 75, "y": 530, "width": 470, "height": 105,
      "text": "Returns: dict\n\n  best:     {rec_id: int, specs: dict, metric_value: float}\n  progress: {completed, total, best_metric, best_rec_id, algorithm}\n  history:  [{rec_id, metric, status}, ...]\n\nAll plain dicts — no AutoML or platform classes exposed.",
      "originalText": "Returns: dict\n\n  best:     {rec_id: int, specs: dict, metric_value: float}\n  progress: {completed, total, best_metric, best_rec_id, algorithm}\n  history:  [{rec_id, metric, status}, ...]\n\nAll plain dicts — no AutoML or platform classes exposed.",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#374151", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 10042, "version": 1, "versionNonce": 10043,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": "returns_box", "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "code_bg", "x": 610, "y": 85, "width": 440, "height": 260,
      "strokeColor": "#1e3a5f", "backgroundColor": "#1e293b",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 20010, "version": 1, "versionNonce": 20011,
      "isDeleted": false, "groupIds": [], "boundElements": [{"id": "code_text", "type": "text"}],
      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "code_text", "x": 625, "y": 95, "width": 410, "height": 240,
      "text": "# Agent usage — this is ALL you need\n\nfrom tao_sdk import TaoExecutionSDK\nfrom tao_automl.runner import AutoMLRunner\n\nsdk = TaoExecutionSDK(creds_file=\"secrets.json\")\n# SDK knows the platform (Lepton/Slurm/K8s)\n\nrunner = AutoMLRunner(sdk)\n# Runner has ZERO platform knowledge\n\nresult = runner.run(\n    network_arch=\"cosmos-rl\",\n    train_dataset_uri=\"aws://bucket/data\",\n    automl_settings={\n        \"algorithm\": \"bayesian\",\n        \"metric\": \"loss\",\n        \"automl_max_recommendations\": 5,\n    },\n    spec_overrides={\"train.epoch\": 3},\n)\nprint(result[\"best\"][\"metric_value\"])",
      "originalText": "# Agent usage — this is ALL you need\n\nfrom tao_sdk import TaoExecutionSDK\nfrom tao_automl.runner import AutoMLRunner\n\nsdk = TaoExecutionSDK(creds_file=\"secrets.json\")\n# SDK knows the platform (Lepton/Slurm/K8s)\n\nrunner = AutoMLRunner(sdk)\n# Runner has ZERO platform knowledge\n\nresult = runner.run(\n    network_arch=\"cosmos-rl\",\n    train_dataset_uri=\"aws://bucket/data\",\n    automl_settings={\n        \"algorithm\": \"bayesian\",\n        \"metric\": \"loss\",\n        \"automl_max_recommendations\": 5,\n    },\n    spec_overrides={\"train.epoch\": 3},\n)\nprint(result[\"best\"][\"metric_value\"])",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 20012, "version": 1, "versionNonce": 20013,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": "code_bg", "lineHeight": 1.25
    },
